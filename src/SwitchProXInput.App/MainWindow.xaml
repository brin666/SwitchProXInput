<Window x:Class="SwitchProXInput.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Switch Pro → XInput"
        Width="520" Height="560" MinWidth="480" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6FA"
        Loaded="Window_Loaded"
        Closed="Window_Closed">
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#172033" />
    <SolidColorBrush x:Key="Muted" Color="#68758A" />
    <SolidColorBrush x:Key="Blue" Color="#285FE8" />
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Height" Value="44" />
      <Setter Property="MinWidth" Value="148" />
      <Setter Property="Padding" Value="18,0" />
      <Setter Property="Background" Value="{StaticResource Blue}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="10">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.9" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="Background" Value="#E7EBF3" />
      <Setter Property="Foreground" Value="#27334A" />
    </Style>
  </Window.Resources>

  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,20">
      <TextBlock Text="Switch Pro → XInput" FontSize="25" FontWeight="Bold" Foreground="{StaticResource Ink}" />
      <TextBlock Text="将 Switch Pro 手柄作为 Xbox 360 控制器提供给 Windows 游戏" Margin="0,6,0,0" FontSize="13" Foreground="{StaticResource Muted}" />
    </StackPanel>

    <Border Grid.Row="1" Padding="16" CornerRadius="14" Background="White" BorderBrush="#E4E9F1" BorderThickness="1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Ellipse x:Name="ConnectionDot" Width="11" Height="11" Margin="1,5,12,0" Fill="#E7A629" />
        <StackPanel Grid.Column="1">
          <TextBlock Text="Switch Pro 手柄" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
          <TextBlock x:Name="ConnectionStatusText" Text="正在检查连接…" Margin="0,4,0,0" FontSize="13" Foreground="{StaticResource Muted}" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="2" Margin="0,12,0,0" Padding="16" CornerRadius="14" Background="White" BorderBrush="#E4E9F1" BorderThickness="1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="虚拟 Xbox 手柄" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
          <TextBlock x:Name="OutputStatusText" Text="未启动" Margin="0,4,0,0" FontSize="13" Foreground="{StaticResource Muted}" />
        </StackPanel>
        <Border x:Name="OutputBadge" Grid.Column="1" Padding="9,5" CornerRadius="8" Background="#EEF1F6" VerticalAlignment="Center">
          <TextBlock x:Name="OutputBadgeText" Text="停止" FontSize="12" FontWeight="SemiBold" Foreground="#68758A" />
        </Border>
      </Grid>
    </Border>

    <Border Grid.Row="3" Margin="0,12,0,0" Padding="16" CornerRadius="14" Background="White" BorderBrush="#E4E9F1" BorderThickness="1">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="摇杆死区" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
          <TextBlock x:Name="DeadzoneValueText" Grid.Column="1" Text="12%" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Blue}" />
        </Grid>
        <Slider x:Name="DeadzoneSlider" Margin="0,8,0,0" Minimum="0" Maximum="30" Value="12" TickFrequency="1" IsSnapToTickEnabled="False" ValueChanged="DeadzoneSlider_ValueChanged" />
        <TextBlock Text="圆形死区会压掉摇杆中心的小幅漂移，并保留完整行程。" Margin="0,3,0,0" FontSize="12" Foreground="{StaticResource Muted}" />
        <TextBlock x:Name="LiveInputText" Text="输入：—" Margin="0,9,0,0" FontSize="12" Foreground="#48556B" />
      </StackPanel>
    </Border>

    <StackPanel Grid.Row="4" Margin="2,15,2,10">
      <TextBlock Text="默认映射" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
      <TextBlock Text="按键位置：下 / 右 / 左 / 上 → A / B / X / Y" Margin="0,6,0,0" FontSize="13" Foreground="#344158" />
      <TextBlock Text="ZL / ZR → LT / RT　　L / R → LB / RB" Margin="0,4,0,0" FontSize="13" Foreground="#344158" />
      <TextBlock Text="摇杆与方向键保持标准 Xbox 布局；断连后输出中性状态并自动等待重连。" Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
      <TextBlock x:Name="ErrorText" Visibility="Collapsed" Margin="0,10,0,0" FontSize="12" Foreground="#B42318" TextWrapping="Wrap" />
    </StackPanel>

    <StackPanel Grid.Row="5">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Button x:Name="StartButton" Grid.Column="0" Content="启动转换" Style="{StaticResource PrimaryButton}" Click="StartButton_Click" />
        <Button x:Name="StopButton" Grid.Column="2" Content="停止" Style="{StaticResource SecondaryButton}" Click="StopButton_Click" IsEnabled="False" />
      </Grid>
      <TextBlock Text="启动虚拟手柄需要管理员授权；首次启动会提示安装第三方组件。" Margin="0,11,0,0" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
    </StackPanel>
  </Grid>
</Window>
